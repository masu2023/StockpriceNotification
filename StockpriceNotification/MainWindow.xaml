<Window x:Class="StockMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📈 株価モニター" Height="700" Width="1100"
        MinWidth="900" MinHeight="580"
        Background="#0D1117" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, sans-serif"
        Closing="Window_Closing">

    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardFlat" TargetType="Border">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#58A6FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#484F58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#238636"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2EA043"/></Trigger>
                <Trigger Property="IsPressed"   Value="True"><Setter Property="Background" Value="#1A7F37"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#DA3633"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F85149"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGray" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30363D"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#9E6A03"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BB8009"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

    </Window.Resources>

    <!-- 最外枠: 上部ヘッダー + 下部2カラム -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ヘッダーバー ══ -->
        <Border Grid.Row="0" Background="#161B22" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📈 株価モニター" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  Japan Stock Price Alert" Foreground="#484F58" FontSize="11" VerticalAlignment="Center" Margin="0,2,0,0"/>
                    <!-- 日経平均テスト表示 -->
                    <Border CornerRadius="6" Padding="10,3" Background="#0D1117" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="日経平均 " Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NikkeiPriceText" Text="---" Foreground="#F0F6FC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NikkeiChangeText" Text="" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🔄 日経取得テスト" Margin="8,0,0,0"
                            Style="{StaticResource BtnGray}" Height="26" FontSize="11" Padding="8,2"
                            Click="TestNikkei_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ステータス -->
                    <Border CornerRadius="10" Padding="8,3" Background="#0D1117" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8B949E" Margin="0,0,5,0"/>
                            <TextBlock x:Name="StatusText" Text="待機中" Foreground="#8B949E" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <!-- 更新間隔 -->
                    <TextBlock Text="更新:" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="IntervalInput" Style="{StaticResource Input}"
                             Text="30" Width="46" FontSize="11" Padding="5,4"/>
                    <TextBlock Text="秒" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="4,0,16,0"/>
                    <!-- 操作ボタン -->
                    <Button x:Name="StartButton" Content="▶ スタート"
                            Style="{StaticResource BtnGreen}" Height="28" Margin="0,0,6,0"
                            Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="⏹ 停止"
                            Style="{StaticResource BtnRed}" Height="28" IsEnabled="False"
                            Click="StopButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 2カラムメインエリア ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左ペイン: 設定 ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,10,6,10">
                <StackPanel>

                    <!-- 銘柄追加 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="🔍 銘柄追加"/>
                            <TextBlock Style="{StaticResource Label}" Text="銘柄コード（例: 7203 / 285A / AAPL）"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TickerInput" Style="{StaticResource Input}"
                                         Text="7203" KeyDown="TickerInput_KeyDown"/>
                                <Button Grid.Column="2" x:Name="AddButton" Content="＋ 追加"
                                        Style="{StaticResource BtnGreen}" VerticalAlignment="Stretch"
                                        Click="AddButton_Click"/>
                                <Button Grid.Column="4" x:Name="DeleteButton" Content="削除"
                                        Style="{StaticResource BtnRed}" VerticalAlignment="Stretch"
                                        IsEnabled="False" Click="DeleteButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Discord Webhook -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="🔗 Discord Webhook"/>
                            <TextBlock Style="{StaticResource Label}" Text="Webhook URL（自動保存）"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WebhookInput" Style="{StaticResource Input}"
                                         Text="" TextChanged="WebhookInput_TextChanged"/>
                                <Button Grid.Column="2" Content="テスト" Style="{StaticResource BtnGray}"
                                        VerticalAlignment="Stretch" Click="TestWebhook_Click"/>
                                <Button Grid.Column="4" Content="クリア" Style="{StaticResource BtnOrange}"
                                        VerticalAlignment="Stretch" Click="ClearWebhook_Click"/>
                            </Grid>
                            <TextBlock x:Name="WebhookSaveStatus" Text="" Foreground="#3FB950"
                                       FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- アラート設定 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="🔔 アラート設定"/>

                            <!-- 価格・変化率 -->
                            <Border Style="{StaticResource CardFlat}">
                                <StackPanel>
                                    <TextBlock Text="📌 価格 / 変化率" Foreground="#8B949E"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioPrice" Style="{StaticResource Radio}"
                                                     Content="価格" IsChecked="True"
                                                     Checked="AlertMode_Changed"/>
                                        <RadioButton x:Name="RadioPercent" Style="{StaticResource Radio}"
                                                     Content="変化率（前日比）"
                                                     Checked="AlertMode_Changed"/>
                                    </StackPanel>
                                    <Grid x:Name="PriceModePanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Label}" Text="上限（円）"/>
                                            <TextBox x:Name="AlertHighPriceInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Label}" Text="下限（円）"/>
                                            <TextBox x:Name="AlertLowPriceInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="PercentModePanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Label}" Text="上昇率 例: 3.0"/>
                                            <TextBox x:Name="AlertHighPctInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Label}" Text="下落率 例: -2.0"/>
                                            <TextBox x:Name="AlertLowPctInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 急騰・急落 -->
                            <Border Style="{StaticResource CardFlat}">
                                <StackPanel>
                                    <TextBlock Text="🔥 急騰 / 急落（直近N秒）" Foreground="#8B949E"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Label}" Text="監視（秒）"/>
                                            <TextBox x:Name="SurgeSecondsInput" Style="{StaticResource Input}" Text="60"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Label}" Text="急騰 例: 3.0"/>
                                            <TextBox x:Name="SurgeUpPctInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource Label}" Text="急落 例: -3.0"/>
                                            <TextBox x:Name="SurgeDownPctInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 出来高急増 -->
                            <Border Style="{StaticResource CardFlat}">
                                <StackPanel>
                                    <TextBlock Text="📊 出来高急増（当日 vs 前日）" Foreground="#8B949E"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Label}" Text="倍率 例: 2.0"/>
                                            <TextBox x:Name="VolumeRatioInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Label}" Text="最低出来高（万株）"/>
                                            <TextBox x:Name="VolumeMinInput" Style="{StaticResource Input}" Text=""/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="EnableAlertCheck" Style="{StaticResource Chk}"
                                      Content="すべてのアラートを有効にする" Margin="0,2,0,0" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- IntervalHint（更新間隔の説明） -->
                    <TextBlock x:Name="IntervalHint" Text="30秒ごとに全銘柄を取得します"
                               Foreground="#484F58" FontSize="10" Margin="2,0,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- 区切り縦線 -->
            <Border Grid.Column="1" Background="#21262D" Width="1" HorizontalAlignment="Center"/>

            <!-- ── 右ペイン: 監視一覧 ── -->
            <Grid Grid.Column="2" Margin="6,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📊 監視銘柄一覧" Foreground="#C9D1D9"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StockCountText"
                               Text="0 銘柄" Foreground="#484F58" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StockPanel"/>
                </ScrollViewer>

                <TextBlock Grid.Row="2" x:Name="LastUpdateText"
                           Text="最終更新: --" Foreground="#484F58" FontSize="10"
                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
